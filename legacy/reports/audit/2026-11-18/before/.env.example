# Execution Mode: "local" (deterministic offline engine) | "openai" | "gemini"
RAG_LLM_MODE=local

# Optional Cloud LLM / Embedding Providers (when switching from local mode)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Distributed Production Infrastructure (see deploy/docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Storage Guardrail: Keep all model/library caches on /Volumes/Data
HF_HOME=/Volumes/Data/.cache/huggingface
TORCH_HOME=/Volumes/Data/.cache/torch
UV_CACHE_DIR=/Volumes/Data/uv/cache
PIP_CACHE_DIR=/Volumes/Data/pip-cache
TMPDIR=/Volumes/Data/tmp
