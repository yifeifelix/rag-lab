# Chat model used by lessons 07-10 (any OpenAI-compatible endpoint).
# cliproxyapi running in OrbStack is reachable from the lab container at:
LLM_BASE_URL=http://host.docker.internal:8317/v1
# One of the api-keys configured in your cliproxyapi config.
LLM_API_KEY=
# A model id your proxy offers. After filling the key, list them in a notebook with:
#   from raglab.llm import list_models; list_models()
LLM_MODEL=

# Optional, for reasoning models: low | medium | high
LLM_REASONING_EFFORT=

# Network binding: 0.0.0.0 = reachable from your LAN, 127.0.0.1 = this Mac only.
LAB_BIND_HOST=0.0.0.0
LAB_PORT=8888
BOOK_PORT=8000
