#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"
export UV_CACHE_DIR="$project_dir/.cache/uv" TMPDIR="$project_dir/.cache/tmp"
export UV_PYTHON_INSTALL_DIR="$project_dir/.cache/uv-python"
mkdir -p "$TMPDIR"
case "$(uname -m)" in
  arm64|aarch64) target=aarch64-unknown-linux-gnu ;;
  x86_64) target=x86_64-unknown-linux-gnu ;;
  *) echo 'Unsupported architecture' >&2; exit 1 ;;
esac
uv pip compile requirements/models.in --python-version 3.12 --python-platform "$target" \
  --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match \
  --generate-hashes --no-header --no-annotate --output-file requirements/models.lock
