+mkdir -p "$TMPDIR" "$PYTHONPYCACHEPREFIX"
+cd "$project_dir"
+action=${1:-start}
+if [ "$#" -gt 0 ]; then shift; fi
+case "$action" in
+  start) exec .venv/bin/python -m uvicorn rag_platform.server:create_app --factory --host 127.0.0.1 --port 8000 "$@" ;;
+  install) exec uv pip install --python .venv/bin/python -e ".[${1:-dev}]" ;;
+  download-model) exec .venv/bin/python -m rag_platform.cli download_model.py "$@" ;;
+  test) exec .venv/bin/python -m pytest "$@" ;;
+  prepare-domain) exec .venv/bin/python -m rag_platform.cli prepare_python_support.py "$@" ;;
+  evaluate-domain) exec .venv/bin/python -m rag_platform.cli run_domain_evaluation.py "$@" ;;
+  prepare-learning) exec .venv/bin/python -m rag_platform.cli prepare_learning_dataset.py "$@" ;;
+  study) exec .venv/bin/python -m rag_platform.cli run_learning_study.py "$@" ;;
+  ablation) exec .venv/bin/python -m rag_platform.cli run_ablation_study.py "$@" ;;
+  synthetic) exec .venv/bin/python -m rag_platform.cli run_10k_benchmark.py "$@" ;;
+  http-benchmark) exec .venv/bin/python -m rag_platform.cli run_http_benchmark.py "$@" ;;
+  audit) exec .venv/bin/python -m rag_platform.cli audit_project.py "$@" ;;
+  lint) exec uvx --python .venv/bin/python --from ruff==0.14.0 ruff check src tests scripts ;;
+  *) echo 'Usage: scripts/workbench {start|install|download-model|test|prepare-domain|evaluate-domain|ablation|synthetic|http-benchmark|audit|lint|prepare-learning|study} [args]' >&2; exit 2 ;;
+esac
