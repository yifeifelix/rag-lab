# Automatically loaded by RAGConfig; exported environment variables take precedence.
RAG_LLM_MODE=local
# local_svd | sentence_transformers (optional package and cached model required)
RAG_EMBEDDING_BACKEND=local_svd
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Explicitly configure provider/model names before live calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=
# Single-owner API protection; required for access beyond loopback.
RAG_ADMIN_TOKEN=
# Operator-verified generation token prices; blank means cost unknown.
RAG_INPUT_USD_PER_MILLION=
RAG_OUTPUT_USD_PER_MILLION=
# Leave paths unset to use the synthetic demo. For the editable real-doc workspace:
# RAG_CORPUS_PATH=/Volumes/Data/Projects/Rag/data/workspaces/python_support/documents.jsonl
# RAG_QA_PATH=/Volumes/Data/Projects/Rag/data/workspaces/python_support/qa_dev.jsonl
# RAG_BOOTSTRAP_SYNTHETIC=false
# scripts/workbench sets model/dependency/temp caches under the project .cache/.
